# Requested ROS-side control state.
mg400_msgs/ControlState target_state

# Zero when starting Servo control; the active lease when stopping it.
uint64 lease_id
---
# True when the requested transition was completed successfully.
bool success

# Actual ROS-side control state after handling the request.
mg400_msgs/ControlState current_state

# New lease after a successful start, zero after a successful stop. A failed
# request must not return an unrelated or fabricated lease.
uint64 lease_id

# Human-readable result or rejection reason.
string message
